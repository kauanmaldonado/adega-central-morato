# =============================================================================
# Variáveis de ambiente — copie para .env.local (desenvolvimento) e cadastre
# as mesmas na hospedagem (Hostinger: Web App → Variáveis de ambiente;
# Vercel: Settings → Environment Variables).
# Detalhes: docs/VARIAVEIS-DE-AMBIENTE.md
# NUNCA versione arquivos .env com valores reais.
# =============================================================================

# --- Obrigatórias (usadas pelo app) ------------------------------------------

# Supabase → Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Supabase → Project Settings → API Keys → chave "anon" (legada) ou "publishable".
# É PÚBLICA por natureza: o acesso aos dados é protegido pelas políticas RLS.
# Nunca coloque aqui a chave service_role/secret — o app se recusa a iniciar.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Endereço público do site, sem barra no final (usado em SEO e links).
# Em produção: o domínio próprio, ex. https://www.seudominio.com.br
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Endereço PRÓPRIO do painel administrativo (só o host, sem https://).
# O painel só abre nesse endereço; no endereço do cardápio ele não existe (404).
# Produção: ex. admin.seudominio.com.br  — SEM ela, o painel fica DESATIVADO
# em produção. Em desenvolvimento pode ficar vazia (painel em localhost:3000/admin)
# ou usar admin.localhost:3000 para testar a separação.
ADMIN_HOST=

# --- Opcionais ----------------------------------------------------------------

# Domínio oficial. Se definido, acessos de produção por outros domínios
# (ex.: *.vercel.app) são redirecionados para ele. Ex.: www.seudominio.com.br
CANONICAL_HOST=

# --- SOMENTE LOCAL — NÃO cadastre na hospedagem (Hostinger/Vercel) ---------

# Chave secreta (service_role / secret). Usada APENAS pelo script
# `npm run create-admin` na sua máquina, para criar o primeiro administrador.
# Ignora todas as regras de segurança do banco: guarde com cuidado.
SUPABASE_SERVICE_ROLE_KEY=
