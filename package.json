{
  "name": "adega-central-morato",
  "version": "1.0.0",
  "private": true,
  "description": "Cardápio digital e painel administrativo da Adega Central Morato (Next.js + Supabase)",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
